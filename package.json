{
  "name": "renovate-config-fabulator",
  "version": "1.10.0",
  "description": "Fabulator personal Renovate config present.",
  "keywords": [
    "renovate",
    "renovateconfig",
    "renovate-config"
  ],
  "homepage": "https://github.com/fabulator/renovate-config-fabulator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabulator/renovate-config-fabulator.git"
  },
  "license": "MIT",
  "author": "Michal Ozogan <michal@ozogan.eu>",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "release": "semantic-release",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "commitlint-config-fabulator": "^6.1.0",
    "eslint": "^10.15.0",
    "eslint-config-fabulator": "^6.0.1",
    "renovate": "^44.259.0",
    "semantic-release-config-fabulator": "^8.0.1"
  },
  "renovate-config": {
    "default": {
      "extends": [
        "config:recommended",
        ":disableDependencyDashboard"
      ],
      "enabled": true,
      "minimumReleaseAge": "3 days",
      "commitMessageAction": "Changed: Update",
      "semanticCommits": "disabled",
      "commitMessageLowerCase": "never",
      "lockFileMaintenance": {
        "enabled": true,
        "automerge": true
      },
      "packageRules": [
        {
          "matchDepTypes": [
            "dependencies",
            "peerDependencies",
            "devDependencies"
          ],
          "matchUpdateTypes": [
            "minor",
            "patch"
          ],
          "enabled": false
        },
        {
          "matchManagers": [
            "github-actions"
          ],
          "commitMessageAction": "Changed: Update Github Flow NO_RELEASE"
        },
        {
          "matchUpdateTypes": [
            "lockFileMaintenance"
          ],
          "commitMessageAction": "Fixed: Update lock file to make security bots happy. NO_RELEASE EXCLUDE",
          "automerge": true
        },
        {
          "matchDepTypes": [
            "devDependencies"
          ],
          "matchUpdateTypes": [
            "major"
          ],
          "commitMessageTopic": "dev dependency {{depName}}",
          "commitMessageSuffix": "NO_RELEASE",
          "major": {
            "automerge": false
          }
        },
        {
          "matchDepTypes": [
            "dependencies",
            "peerDependencies"
          ],
          "matchUpdateTypes": [
            "major"
          ],
          "commitMessageSuffix": "BREAKING",
          "minimumReleaseAge": "3 days"
        }
      ],
      "prCreation": "not-pending",
      "rangeStrategy": "bump",
      "automerge": true,
      "major": {
        "automerge": false
      },
      "timezone": "Europe/Prague",
      "schedule": [
        "after 5am"
      ],
      "assignees": [
        "fabulator"
      ],
      "reviewers": [
        "fabulator"
      ]
    }
  }
}
